# Izenzo — environment variable names only. Never commit real values.

# --- Client-visible (bundled into the browser build) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Server-only (server functions and server routes) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection used only by Drizzle Kit to apply migrations.
LOVABLE_DB_MIGRATION_URL=

# --- AI gateway (document reading, matching, AI+ advisory) ---
# Supplied by the hosting platform in the current deployment.
LOVABLE_API_KEY=
AI_PLUS_MODEL=

# --- Stored-credential encryption (REQUIRED) ---
# AES key that encrypts every provider credential held in integration_credentials.
# Without this exact value the stored Firecrawl, Resend, PayFast, DIDIT and
# exchange-rate credentials cannot be decrypted and no integration will work.
INTEGRATION_ENCRYPTION_KEY=
# Second gate: an admin must enter this to reveal a stored credential on screen.
# When unset, nothing can ever be revealed (fails closed).
INTEGRATIONS_VAULT_PASSWORD=

# --- Scheduled-caller authentication ---
# Bearer secret accepted by authenticateCronRequest(). No scheduled job uses it today;
# _PREVIOUS allows a rotation window where both values are accepted.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# --- Integrations (optional; also configurable in the admin screens) ---
FIRECRAWL_API_KEY=
RESEND_API_KEY=
# Sender address for outgoing notification email (defaults to no-reply@izenzo.co.za).
RESEND_FROM_ADDRESS=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
COMPLYADVANTAGE_API_KEY=
EXCHANGE_RATE_API_KEY=

# --- Protected AI+ decision service (not wired up yet; see the handover pack) ---
AI_PLUS_PRIVATE_URL=
AI_PLUS_HMAC_KEY_ID=
AI_PLUS_HMAC_SECRET=
